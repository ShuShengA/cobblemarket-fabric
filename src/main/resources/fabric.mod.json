{
	"schemaVersion": 1,
	"id": "cobblemarket",
	"version": "${version}",
	"name": "CobbleMarket",
	"description": "A player-to-player trading market for Cobblemon: buy and sell Pokémon and items, with configurable listing fees, per-player bans, transaction history, expired listing returns, and optional CobbleDollars currency support.",
	"authors": [
		"Shu_ShengA"
	],
	"license": "MIT",
	"icon": "assets/cobblemarket/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.shusheng.cobblemarket.CobbleMarket",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.shusheng.cobblemarket.client.CobbleMarketClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.shusheng.cobblemarket.CobbleMarketDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"cobblemon": ">=1.7.0"
	}
}